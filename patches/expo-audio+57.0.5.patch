+      ACTION_SHUFFLE -> currentPlayer?.emit("onRemoteShuffle", payload)
+      ACTION_REPEAT -> currentPlayer?.emit("onRemoteRepeat", payload)
+      ACTION_SEEK -> currentPlayer?.emit("onRemoteSeek", payload)
