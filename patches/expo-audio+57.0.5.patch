+@OptIn(UnstableApi::class)
+private class TransportCommandPlayer(
+  player: Player,
+  private val onCommand: (String, Map<String, Any?>) -> Unit
+) : ForwardingPlayer(player) {
+  private val listeners = IdentityHashMap<Player.Listener, Boolean>()
+  private var shuffleEnabled = false
+  private var appRepeatMode = Player.REPEAT_MODE_OFF
+  private var injectedDurationMs = 0L
+  private var positionOffsetMs = 0L
+  private var ignoreLeadInSeekUntil = 0L
+  private var timelineAppliedAt = 0L
+
+  override fun addListener(listener: Player.Listener) {
+    synchronized(listeners) { listeners[listener] = true }
+    super.addListener(listener)
+  }
+
+  override fun removeListener(listener: Player.Listener) {
+    synchronized(listeners) { listeners.remove(listener) }
+    super.removeListener(listener)
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean {
+    if (command == Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM && duration > 0) return true
+    return command == Player.COMMAND_SEEK_TO_NEXT ||
+      command == Player.COMMAND_SEEK_TO_PREVIOUS ||
+      command == Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM ||
+      command == Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM ||
+      command == Player.COMMAND_SET_SHUFFLE_MODE ||
+      command == Player.COMMAND_SET_REPEAT_MODE ||
+      super.isCommandAvailable(command)
+  }
+
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands().buildUpon()
+      .add(Player.COMMAND_SEEK_TO_NEXT)
+      .add(Player.COMMAND_SEEK_TO_PREVIOUS)
+      .add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+      .add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+      .add(Player.COMMAND_SET_SHUFFLE_MODE)
+      .add(Player.COMMAND_SET_REPEAT_MODE)
+    if (duration > 0) commands.add(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+    return commands.build()
+  }
+
+  override fun getDuration(): Long {
+    val native = super.getDuration()
+    if (injectedDurationMs > 0 && (native == C.TIME_UNSET || native <= 0L || positionOffsetMs > 0L)) {
+      return injectedDurationMs
+    }
+    return if (native == C.TIME_UNSET) 0L else native
+  }
+
+  override fun getCurrentPosition(): Long {
+    val raw = super.getCurrentPosition()
+    val base = if (raw < 0L) 0L else raw
+    val position = positionOffsetMs + base
+    val length = duration
+    return if (length > 0L) position.coerceAtMost(length) else position
+  }
+
+  override fun seekTo(positionMs: Long) {
+    val wallMs = positionMs.coerceAtLeast(0L)
+    val now = android.os.SystemClock.elapsedRealtime()
+    // Publishing a new duration makes the system seek back to the start. That is not a scrub.
+    if (now < ignoreLeadInSeekUntil) return
+    if (wallMs < 1_500L && timelineAppliedAt > 0L && now < timelineAppliedAt + 8_000L) return
+    val current = currentPosition
+    if (kotlin.math.abs(wallMs - current) < 2_000L) return
+    val native = super.getDuration()
+    val mediaMs = (wallMs - positionOffsetMs).coerceAtLeast(0L)
+    if (native != C.TIME_UNSET && native > 0L) {
+      super.seekTo(mediaMs.coerceAtMost(native))
+      onCommand(AudioControlsService.ACTION_SEEK, mapOf("position" to wallMs / 1000.0))
+    } else {
+      onCommand(
+        AudioControlsService.ACTION_SEEK,
+        mapOf("position" to wallMs / 1000.0, "perform" to true)
+      )
+    }
+  }
+
+  override fun hasNextMediaItem(): Boolean = true
+
+  override fun hasPreviousMediaItem(): Boolean = true
+
+  override fun seekToNext() {
+    onCommand(AudioControlsService.ACTION_NEXT_TRACK, emptyMap())
+  }
+
+  override fun seekToNextMediaItem() {
+    seekToNext()
+  }
+
+  override fun seekToPrevious() {
+    onCommand(AudioControlsService.ACTION_PREVIOUS_TRACK, emptyMap())
+  }
+
+  override fun seekToPreviousMediaItem() {
+    seekToPrevious()
+  }
+
+  override fun getShuffleModeEnabled(): Boolean = shuffleEnabled
+
+  override fun setShuffleModeEnabled(shuffleModeEnabled: Boolean) {
+    if (shuffleEnabled == shuffleModeEnabled) return
+    shuffleEnabled = shuffleModeEnabled
+    notifyTransportChanged()
+    onCommand(AudioControlsService.ACTION_SHUFFLE, mapOf("enabled" to shuffleModeEnabled))
+  }
+
+  override fun getRepeatMode(): Int = appRepeatMode
+
+  override fun setRepeatMode(repeatMode: Int) {
+    if (appRepeatMode == repeatMode) return
+    appRepeatMode = repeatMode
+    notifyTransportChanged()
+    val name = when (repeatMode) {
+      Player.REPEAT_MODE_ONE -> "one"
+      Player.REPEAT_MODE_ALL -> "all"
+      else -> "off"
+    }
+    onCommand(AudioControlsService.ACTION_REPEAT, mapOf("mode" to name))
+  }
+
+  fun applyFromApp(shuffle: Boolean, repeatMode: Int) {
+    val changed = shuffleEnabled != shuffle || appRepeatMode != repeatMode
+    shuffleEnabled = shuffle
+    appRepeatMode = repeatMode
+    if (changed) notifyTransportChanged()
+  }
+
+  fun applyTimeline(durationMs: Double, offsetMs: Double) {
+    val nextDuration = durationMs.toLong().coerceAtLeast(0L)
+    val nextOffset = offsetMs.toLong().coerceAtLeast(0L)
+    val changed = injectedDurationMs != nextDuration || positionOffsetMs != nextOffset
+    injectedDurationMs = nextDuration
+    positionOffsetMs = nextOffset
+    timelineAppliedAt = android.os.SystemClock.elapsedRealtime()
+    ignoreLeadInSeekUntil = timelineAppliedAt + 4_000L
+    if (!changed) return
+    val current = synchronized(listeners) { listeners.keys.toList() }
+    val events = Player.Events(
+      FlagSet.Builder()
+        .add(Player.EVENT_TIMELINE_CHANGED)
+        .add(Player.EVENT_AVAILABLE_COMMANDS_CHANGED)
+        .build()
+    )
+    current.forEach {
+      it.onAvailableCommandsChanged(availableCommands)
+      it.onEvents(this, events)
+    }
+  }
+
+  private fun notifyTransportChanged() {
+    val current = synchronized(listeners) { listeners.keys.toList() }
+    val events = Player.Events(
+      FlagSet.Builder()
+        .add(Player.EVENT_SHUFFLE_MODE_ENABLED_CHANGED)
+        .add(Player.EVENT_REPEAT_MODE_CHANGED)
+        .add(Player.EVENT_AVAILABLE_COMMANDS_CHANGED)
+        .build()
+    )
+    current.forEach {
+      it.onShuffleModeEnabledChanged(shuffleEnabled)
+      it.onRepeatModeChanged(appRepeatMode)
+      it.onAvailableCommandsChanged(availableCommands)
+      it.onEvents(this, events)
+    }
+  }
+}
